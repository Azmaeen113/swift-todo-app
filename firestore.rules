rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Todos ────────────────────────────────────────────────────────────────
    // A user can only read and write their OWN todos.
    match /todos/{todoId} {

      // Allow read only if the document's uid field matches the signed-in user
      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;

      // Allow create only if:
      //   • the user is authenticated
      //   • the uid field they submit equals their own UID (no spoofing)
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 1000;

      // Allow update only if the document already belongs to the user
      // and they are NOT changing the uid or createdAt fields
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.createdAt == resource.data.createdAt;

      // Allow delete only if the document belongs to the user
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
